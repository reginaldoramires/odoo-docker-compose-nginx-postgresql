# Chatwoot Environment Variables
# Copy this file to .env.chatwoot and fill in your values

# Database Configuration
POSTGRES_PASSWORD=chatwoot
POSTGRES_USER=chatwoot
POSTGRES_DATABASE=chatwoot_production

# Redis Configuration
REDIS_URL=redis://chatwoot_redis:6379

# Application Configuration
# Generate a secret key with: openssl rand -hex 64
SECRET_KEY_BASE=replace_with_your_secret_key_base

# Frontend URL (adjust according to your domain)
FRONTEND_URL=http://localhost:3000

# Mailer Configuration
MAILER_SENDER_EMAIL=chatwoot@yourdomain.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Storage Configuration
ACTIVE_STORAGE_SERVICE=local
# For S3:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1

# Chatwoot Settings
INSTALLATION_NAME=Chatwoot Odoo Integration
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true

# Odoo Integration
ODOO_URL=http://odoo:8069
WEBHOOK_ENABLED=true
