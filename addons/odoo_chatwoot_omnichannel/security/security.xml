<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Categories -->
        <record id="module_category_chatwoot" model="ir.module.category">
            <field name="name">Chatwoot Omnichannel</field>
            <field name="description">Chatwoot Omnichannel Integration</field>
            <field name="sequence">15</field>
        </record>

        <!-- Groups -->
        <record id="group_chatwoot_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_chatwoot"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_chatwoot_agent" model="res.groups">
            <field name="name">Agent</field>
            <field name="category_id" ref="module_category_chatwoot"/>
            <field name="implied_ids" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <record id="group_chatwoot_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_chatwoot"/>
            <field name="implied_ids" eval="[(4, ref('group_chatwoot_agent'))]"/>
        </record>

        <record id="group_chatwoot_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_chatwoot"/>
            <field name="implied_ids" eval="[(4, ref('group_chatwoot_manager'))]"/>
        </record>

        <!-- Record Rules -->

        <!-- Chatwoot Account -->
        <record id="chatwoot_account_rule_user" model="ir.rule">
            <field name="name">Chatwoot Account: User - See all</field>
            <field name="model_id" ref="model_chatwoot_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <!-- Chatwoot Conversation -->
        <record id="chatwoot_conversation_rule_agent" model="ir.rule">
            <field name="name">Chatwoot Conversation: Agent - Own conversations</field>
            <field name="model_id" ref="model_chatwoot_conversation"/>
            <field name="domain_force">[('assignee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_agent'))]"/>
        </record>

        <record id="chatwoot_conversation_rule_manager" model="ir.rule">
            <field name="name">Chatwoot Conversation: Manager - See all</field>
            <field name="model_id" ref="model_chatwoot_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_manager'))]"/>
        </record>

        <!-- Chatwoot Message -->
        <record id="chatwoot_message_rule_agent" model="ir.rule">
            <field name="name">Chatwoot Message: Agent - Own conversation messages</field>
            <field name="model_id" ref="model_chatwoot_message"/>
            <field name="domain_force">[('conversation_id.assignee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_agent'))]"/>
        </record>

        <record id="chatwoot_message_rule_manager" model="ir.rule">
            <field name="name">Chatwoot Message: Manager - See all</field>
            <field name="model_id" ref="model_chatwoot_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_manager'))]"/>
        </record>

        <!-- Chatwoot Contact -->
        <record id="chatwoot_contact_rule_user" model="ir.rule">
            <field name="name">Chatwoot Contact: User - See all</field>
            <field name="model_id" ref="model_chatwoot_contact"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <!-- Other models - All users can see -->
        <record id="chatwoot_inbox_rule_user" model="ir.rule">
            <field name="name">Chatwoot Inbox: User - See all</field>
            <field name="model_id" ref="model_chatwoot_inbox"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <record id="chatwoot_agent_rule_user" model="ir.rule">
            <field name="name">Chatwoot Agent: User - See all</field>
            <field name="model_id" ref="model_chatwoot_agent"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <record id="chatwoot_team_rule_user" model="ir.rule">
            <field name="name">Chatwoot Team: User - See all</field>
            <field name="model_id" ref="model_chatwoot_team"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

        <record id="chatwoot_label_rule_user" model="ir.rule">
            <field name="name">Chatwoot Label: User - See all</field>
            <field name="model_id" ref="model_chatwoot_label"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatwoot_user'))]"/>
        </record>

    </data>
</odoo>
